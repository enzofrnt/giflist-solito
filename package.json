{
  "name": "solito-blank",
  "private": true,
  "devDependencies": {
    "@types/react": "^19",
    "eslint": "^8.21.0",
    "husky": "^9.1.7",
    "turbo": "^2.4.4",
    "typescript": "^5.2.2"
  },
  "scripts": {
    "native": "bun run --cwd apps/expo start",
    "web:dev": "bun run --cwd apps/next dev",
    "web:build": "bun run --cwd apps/next build",
    "web:build:vercel": "bun run --cwd apps/next build:vercel",
    "web:start": "bun run --cwd apps/next start",
    "web:typecheck": "bun run --cwd apps/next typecheck",
    "test": "bun run --cwd apps/next test:password-reset",
    "android": "bun run --cwd apps/expo android",
    "ios": "bun run --cwd apps/expo ios",
    "prepare": "husky",
    "postinstall": "bun run --cwd apps/next db:generate",
    "native:export": "bun run --cwd apps/expo export",
    "web:lint": "bun run --cwd apps/next lint .",
    "native:typecheck": "bun run --cwd apps/expo typecheck",
    "native:doctor": "bun run --cwd apps/expo doctor",
    "db:seed:demo": "bun run --cwd apps/next db:seed:demo"
  },
  "eslintConfig": {
    "extends": "next",
    "settings": {
      "next": {
        "rootDir": "apps/next/"
      }
    },
    "root": true
  },
  "prettier": {
    "semi": false,
    "useTabs": false,
    "tabWidth": 2,
    "singleQuote": true
  },
  "packageManager": "bun@1.4.4",
  "version": "1.0.0",
  "dependencies": {
    "expo": "^57.0.17",
    "react": "19.2.0",
    "react-native": "0.86.3"
  },
  "engines": {
    "bun": ">=1.4.4 <1.5.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "@prisma/client",
    "@prisma/engines",
    "esbuild",
    "prisma",
    "puppeteer",
    "sharp",
    "unrs-resolver"
  ],
  "overrides": {
    "sharp": "0.35.5"
  }
}
