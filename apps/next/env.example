# Variables d'environnement

# Base de données PostgreSQL (développement local avec Docker)
# Démarrez Docker avec: docker-compose up -d
POSTGRES_PRISMA_URL="postgresql://gift_user:gift_password@localhost:5432/gift_db?schema=public&pgbouncer=true&connect_timeout=15"

# Base de données PostgreSQL (production Vercel)
# DATABASE_URL="postgresql://username:password@aws-1-eu-west-2.pooler.supabase.com:5432/postgres?schema=public"
# POSTGRES_PRISMA_URL="postgresql://username:password@aws-1-eu-west-2.pooler.supabase.com:6543/postgres?schema=public&pgbouncer=true"
# Pour Supabase, utilisez l'URL de connexion directe (non-pooling) dans DATABASE_URL

# URL de base de l'application
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Pour la production, remplacez par votre URL Vercel
# NEXT_PUBLIC_BASE_URL="https://votre-app.vercel.app"

# Clé secrète JWT (générer avec: openssl rand -base64 32)
JWT_SECRET="votre-cle-secrete-jwt-changez-en-production"

# Espace administrateur (/admin) — variables exclusivement serveur
# L'espace administrateur est désactivé tant que ces deux variables sont absentes
# ou vides : la page /admin et les routes /api/admin/* refusent alors tout accès.
# À définir en local dans .env.local et sur Vercel (environnement Production).
# Le mot de passe est stocké uniquement sous forme de hash bcrypt (coût 12),
# jamais en clair et jamais versionné. Générez le hash depuis apps/next avec :
#   bun -e "import bcrypt from 'bcryptjs'; console.log(bcrypt.hashSync('votre-mot-de-passe', 12))"
ADMIN_USERNAME=""
# Coller ici le hash bcrypt généré par la commande ci-dessus (commence par un
# préfixe bcrypt et ne doit JAMAIS contenir le mot de passe en clair).
ADMIN_PASSWORD_HASH=""

# Réinitialisation de mot de passe (variables exclusivement serveur)
# En production : APP_URL="https://giftlist.fr"
# Preview Vercel : URL automatique via VERCEL_BRANCH_URL / VERCEL_URL, sans APP_URL.
APP_URL="http://localhost:3000"
EMAIL_FROM="Giftlist <noreply@giftlist.fr>"
# Clé Resend limitée à l'envoi sur le domaine vérifié
RESEND_API_KEY=""

# Clé API pour le scraping de produits (optionnel)
# Inscrivez-vous sur https://www.scrapingbee.com/ pour obtenir une clé gratuite

# Vercel Blob (images de listes/cadeaux) — jeton du store Blob
BLOB_READ_WRITE_TOKEN=
