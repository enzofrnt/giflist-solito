{
  "name": "myapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test:password-reset": "bun run db:generate && bun test tests/*.test.ts",
    "dev": "bun run --bun next dev --webpack",
    "dev:debug": "bun --inspect run --bun next dev --webpack",
    "dev:no-debug": "bun run dev",
    "build": "bun run db:generate && bun run --bun next build --webpack",
    "start": "bun run --bun next start",
    "lint": "bun run --bun eslint",
    "db:push": "bun run --bun prisma db push",
    "db:migrate": "bun run --bun prisma migrate deploy",
    "db:generate": "bun run --bun prisma generate --schema prisma/schema.production.prisma",
    "db:migrate:dev": "bun run --bun prisma migrate dev",
    "db:migrate:create": "bun run --bun prisma migrate dev --create-only",
    "db:migrate:reset": "bun run --bun prisma migrate reset",
    "db:studio": "bun run --bun prisma studio",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f postgres",
    "docker:reset": "docker-compose down -v && docker-compose up -d",
    "build:vercel": "bun scripts/build-vercel.mjs",
    "typecheck": "bun run --bun tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/qrcode": "^1.5.5",
    "@vercel/speed-insights": "^1.2.0",
    "app": "workspace:*",
    "bcryptjs": "^3.0.2",
    "jsonwebtoken": "^9.0.2",
    "next": "16.4.3",
    "puppeteer": "^24.20.0",
    "qr-code-styling": "^1.9.2",
    "qrcode": "^1.5.4",
    "qrcode-generator": "^2.0.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-svg": "^15.14.0",
    "react-native-web": "^0.21.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@electric-sql/pglite-socket": "0.2.16",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "^6.16.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.4"
}
